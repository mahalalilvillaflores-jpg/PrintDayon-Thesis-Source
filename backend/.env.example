# Server Environment (Render sets PORT automatically)
PORT=5000
NODE_ENV=production

# Database (For Render, use a free MongoDB Atlas connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/printdayon?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/printdayon?retryWrites=true&w=majority

# Security
JWT_SECRET=generate_a_long_random_secret_for_production_security
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Only required if frontend is hosted on a separate domain)
# For unified single-service deploy on Render, this can match your Render URL:
CLIENT_URL=https://your-service-name.onrender.com

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
